<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <!-- Releases added by tools/bump-version.sh -->

 <id>xreader.desktop</id>
 <metadata_license>CC0-1.0</metadata_license>
 <project_license>GPL-2.0+</project_license>
 <name>Document Viewer</name>
 <_summary>A Document Viewer</_summary>
 <_description>
  <p>
   Xreader is a simple multi-page document viewer. It can display and
   print PostScript (PS), Encapsulated PostScript (EPS), DJVU, DVI,
   XPS and Portable Document Format (PDF) files, as well as comic book
   archive files. When supported by the document, it also allows
   searching for text, copying text to the clipboard, hypertext navigation
   and table-of-contents bookmarks.
  </p>
 </_description>
 <url type="homepage">http://github.com/linuxmint/xreader</url>
 <url type="bugtracker">http://github.com/linuxmint/xreader/issues</url>
 <project_group>Linux Mint</project_group>
 <developer_name>Linux Mint Team</developer_name>
 <screenshots>
   <screenshot type="default">
     <caption>Xreader displaying a PDF document</caption>
     <image>https://raw.githubusercontent.com/linuxmint/xreader/master/data/screenshot-main.png</image>
   </screenshot>
   <screenshot>
     <caption>The bookmarks sidebar</caption>
     <image>https://raw.githubusercontent.com/linuxmint/xreader/master/data/screenshot-bookmarks.png</image>
   </screenshot>
 </screenshots>
 <categories>
   <category>Office</category>
   <category>Viewer</category>
 </categories>
 <keywords>
   <keyword>pdf</keyword>
   <keyword>djvu</keyword>
   <keyword>dvi</keyword>
   <keyword>xps</keyword>
   <keyword>epub</keyword>
   <keyword>comics</keyword>
   <keyword>document</keyword>
   <keyword>viewer</keyword>
   <keyword>cbz</keyword>
   <keyword>cbr</keyword>
   <keyword>postscript</keyword>
 </keywords>
 <provides>
   <binary>xreader</binary>
   <binary>xreader-previewer</binary>
   <binary>xreader-thumbnailer</binary>
 </provides>
 <mimetypes>
   <mimetype>application/pdf</mimetype>
   <mimetype>application/postscript</mimetype>
   <mimetype>application/x-dvi</mimetype>
   <mimetype>application/x-cbr</mimetype>
   <mimetype>application/x-cbz</mimetype>
   <mimetype>application/x-xz-compressed-tar</mimetype>
   <mimetype>application/oxps</mimetype>
   <mimetype>image/vnd.djvu</mimetype>
   <mimetype>image/tiff</mimetype>
   <mimetype>image/x-xpixmap</mimetype>
 </mimetypes>
  <releases>
    <release version="4.8.1" date="2026-08-28">
      <description>
        <p>Xreader Pro 4.8.1 release:</p>
        <ul>
          <li>Native tabbed document browsing embedded in EvWindow with full-width bar and natural title sizing</li>
          <li>Enterprise X.509 PKI Digital Signature verification</li>
          <li>Integrated Tesseract Optical Character Recognition (OCR)</li>
          <li>GTK4 modern architecture and hardware-accelerated rendering compatibility</li>
          <li>Comprehensive security hardening across DVI, SyncTeX, EPUB, and DjVu backends</li>
        </ul>
      </description>
    </release>
    <release version="4.8.0" date="2026-07-30">
      <description>
        <p>30 self-PRs landed in the yuri-schmaltz/xreader fork, covering:</p>
        <ul>
          <li>NEW: C3 Tabbed view (PRs #96-#107) -- open multiple documents in tabs in a single window. Keyboard shortcuts (Ctrl+Tab, Ctrl+W, Ctrl+Shift+T), drag-and-drop, reopen-closed-tab, session save/restore. --tabbed / -T CLI flag + tabbed-mode GSettings.</li>
          <li>gtk-doc blocks on 9 public headers (PRs #52, #56-#60)</li>
          <li>12 G_GNUC_NONNULL + 1 G_GNUC_PURE + 5 G_GNUC_MALLOC + 4 G_GNUC_WARN_UNUSED_RESULT + 3 G_GNUC_PRINTF annotations (PRs #43, #61-#63)</li>
          <li>g_slice_* -> g_new/g_free in 4 files (PR #64)</li>
          <li>g_get_current_time -> g_get_real_time in ev-file-helpers.c (PR #65)</li>
          <li>strcasecmp -> g_ascii_strcasecmp in ev-document.c (PR #66)</li>
          <li>6 new CI jobs: clang-tidy, iwyu, valgrind, coverity-scan, ARM64, clang (PRs #67-#71, #80) -- 12 total</li>
          <li>_FORTIFY_SOURCE=3 + -fstack-protector-strong (PR #81)</li>
          <li>tools/lint-branches.sh (PR #85)</li>
          <li>ev_form_field_type_to_string / _from_string helpers (PR #78) + 9 unit tests (PR #79)</li>
          <li>ev_rectangle_intersect helper (PR #87) + 9 unit tests (PR #88)</li>
          <li>7 GAction entries (B1 phase 1) -- quit, help, about, open-location, print, save, find (PRs #76, #77, #89)</li>
          <li>Flatpak + Snap manifests (PRs #74, #75)</li>
          <li>AppStream expansion (PR #73)</li>
          <li>Full doc set: CONTRIBUTING, CODE_OF_CONDUCT, SUPPORT, ARCHITECTURE, ROADMAP, GACTION_MIGRATION, TABBED_VIEW + TABBED_VIEW_TEST_PLAN (PRs #91-#95, #103, #105)</li>
          <li>96 unit tests across 11 executables + 2 fuzz harnesses with 11 seeds</li>
        </ul>
      </description>
    </release>
    <release version="4.7.0" date="2026-07-28">
      <description>
        <p>31 self-PRs landed in the yuri-schmaltz/xreader fork, covering:</p>
        <ul>
          <li>4 command-injection / buffer-overflow security fixes (PRs #1, #2, #10, #18)</li>
          <li>5 GTK_STOCK_* deprecation cleanups (PRs #3-#7)</li>
          <li>16 icon name modernizations to xsi-*-symbolic (PRs #14, #15)</li>
          <li>CI hardening: strict-warnings + ASan/UBSan + 60s libFuzzer smoke (PRs #8, #19)</li>
          <li>New libFuzzer harness with seed corpus (PRs #13, #29)</li>
          <li>Unit test bootstrap (PRs #11, #25, #31)</li>
          <li>System libzip migration (PR #12, removes 3,067 lines of embedded minizip)</li>
          <li>Developer tooling: .editorconfig, .clang-format, HACKING.md, RELEASE.md, NEWS, SECURITY.md, .mailmap (PRs #16, #17, #20-#22)</li>
          <li>Various: ev_stock_icons xsi migration, gtk_dialog_get_action_area cleanup, afmparse.c g_strdup, g_build_filename in epub (PRs #15, #27, #28, #30)</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
