prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@/xreader-pro/@EV_API_VERSION@

Name: Xreader Pro View
Description: Xreader Pro document viewer view library
Version: @VERSION@
